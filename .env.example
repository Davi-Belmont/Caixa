# Copie para ".env" e ajuste:  cp .env.example .env
# Use só letras e números nas senhas (caracteres especiais quebram a URL do banco).
#   gerar:  openssl rand -hex 24

POSTGRES_USER=caixa
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=caixa_db

# Segredo que assina os logins (JWT). Trocar invalida as sessões abertas.
#   gerar:  openssl rand -hex 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta em que o app abre no servidor:  http://IP-DO-SERVIDOR:8080
WEB_PORT=8080

TZ=America/Fortaleza
